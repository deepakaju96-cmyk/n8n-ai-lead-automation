    {
      "parameters": {
        "jsCode": "// Collect existing company names for dedup\nconst sheetRows = $input.all();\nconst existingCompanies = sheetRows\n  .map(r => (r.json.company || '').toLowerCase().trim())\n  .filter(c => c.length > 0);\nconst existingWebsites = sheetRows\n  .map(r => (r.json.company_website || '').toLowerCase().trim())\n  .filter(w => w.length > 0);\n\n// Search queries matching Asteris ICP \u2014 equine vet + imaging/radiology\nconst queries = [\n  'equine veterinary clinic',\n  'equine hospital',\n  'equine practice',\n  'horse veterinarian',\n  'ambulatory equine veterinarian',\n  'veterinary imaging center',\n  'veterinary radiology clinic',\n  'veterinary PACS diagnostic imaging',\n  'teleradiology veterinary',\n  'diagnostic imaging veterinary',\n  'veterinary hospital'\n];\n\nconst states = [\n  'California', 'Texas', 'Florida', 'Kentucky', 'Virginia',\n  'Colorado', 'New York', 'Pennsylvania', 'Oregon', 'Washington',\n  'Arizona', 'Oklahoma', 'North Carolina', 'Georgia', 'Tennessee',\n  'Ohio', 'Michigan', 'Illinois', 'Maryland', 'New Jersey',\n  'Montana', 'Wyoming', 'Idaho', 'New Mexico', 'Missouri',\n  'Connecticut', 'Massachusetts', 'South Carolina', 'Indiana', 'Wisconsin',\n  'Ontario Canada', 'British Columbia Canada', 'Alberta Canada'\n];\n\n// Use lead count to pick which query+state combo\nconst totalLeads = existingCompanies.length;\nconst queryIndex = totalLeads % queries.length;\nconst stateIndex = Math.floor(totalLeads / queries.length) % states.length;\n\nconst searchQuery = queries[queryIndex];\nconst state = states[stateIndex];\n\nreturn [{\n  json: {\n    searchQuery: searchQuery + ' ' + state,\n    state,\n    queryType: searchQuery,\n    existingCompanies,\n    existingWebsites,\n    totalExisting: totalLeads\n  }\n}];"
      },
      "id": "gmf-rotation-001",
      "name": "Rotate Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        384
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/compass~crawler-google-places/run-sync-get-dataset-items?token=YOUR_APIFY_TOKEN",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchStringsArray\": [\"{{ $json.searchQuery }}\"],\n  \"maxCrawledPlacesPerSearch\": 5,\n  \"language\": \"en\",\n  \"deeperCityScrape\": false,\n  \"skipClosedPlaces\": true\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "gmf-google-maps-001",
      "name": "Google Maps Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        384
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.all();\nconst existingCompanies = new Set($('Rotate Search').first().json.existingCompanies || []);\nconst existingWebsites = new Set($('Rotate Search').first().json.existingWebsites || []);\n\nconst newClinics = [];\nconst now = new Date().toISOString();\n\nfor (const r of results) {\n  const place = r.json;\n  const name = (place.title || place.name || '').trim();\n  const nameLower = name.toLowerCase();\n  const website = (place.website || place.url || '').toLowerCase().replace(/^https?:\\/\\//, '').replace(/\\/$/, '');\n  const phone = place.phone || place.phoneUnformatted || '';\n  const address = place.address || place.street || '';\n  const city = place.city || '';\n  const state = place.state || '';\n\n  if (!nameLower) continue;\n  if (existingCompanies.has(nameLower)) continue;\n  if (website && existingWebsites.has(website)) continue;\n\n  // Build a ready-to-use lead object\n  newClinics.push({\n    json: {\n      company: name,\n      first_name: '',\n      last_name: name,\n      email: '',\n      phone,\n      company_website: website ? (website.includes('://') ? website : 'https://' + website) : '',\n      title: '',\n      city,\n      state,\n      country: 'United States',\n      org_industry: 'veterinary',\n      org_size: '',\n      source: 'Google Maps Lead Finder',\n      scraped_date: now,\n      name: name,\n      address,\n      rating: place.totalScore || place.rating || '',\n      reviews: place.reviewsCount || place.reviews || 0,\n      category: place.categoryName || place.category || '',\n      has_new: true\n    }\n  });\n}\n\n// Return up to 5 new clinics, or a skip marker\nif (newClinics.length > 0) {\n  return newClinics;\n} else {\n  return [{ json: { has_new: false, skip: true, message: 'No new clinics found' } }];\n}"
      },
